<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Remote TCP log streaming configuration, overridable via Spring properties / environment variables. -->
    <springProperty scope="context" name="flaicheckbot.logging.tcp.enabled"
                    source="flaicheckbot.logging.tcp.enabled" defaultValue="false"/>
    <springProperty scope="context" name="flaicheckbot.logging.tcp.destinations"
                    source="flaicheckbot.logging.tcp.destinations" defaultValue="127.0.0.1:4560"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>flaicheckbot.logging.tcp.enabled</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <!-- Asynchronous TCP appender streaming JSON (Logstash format).
                 It never blocks the logging thread (events are dropped when the ring buffer is full)
                 and automatically reconnects or fails over across destinations if a receiver is unavailable. -->
            <appender name="TCP_LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
                <destination>${flaicheckbot.logging.tcp.destinations}</destination>
                <reconnectionDelay>5 seconds</reconnectionDelay>
                <shutdownGracePeriod>5 seconds</shutdownGracePeriod>
                <ringBufferSize>1024</ringBufferSize>
                <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                    <customFields><![CDATA[{"application":"flaicheckbot"}]]></customFields>
                </encoder>
            </appender>

            <root level="INFO">
                <appender-ref ref="TCP_LOGSTASH"/>
            </root>
        </then>
    </if>
</configuration>
